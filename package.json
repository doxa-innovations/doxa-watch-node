{
  "name": "@doxa-innovations/watch",
  "version": "0.1.0",
  "description": "Node and Next.js collector for Doxa Watch: requests, exceptions, outgoing requests, logs and users, sent straight from the Node process.",
  "license": "MIT",
  "author": "Doxa Innovations PLC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doxa-innovations/doxa-watch-node.git"
  },
  "keywords": ["@doxa-innovations/watch", "monitoring", "nextjs", "observability", "nightwatch"],
  "engines": {
    "node": ">=18.18"
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "bin": {
    "@doxa-innovations/watch": "./dist/cli/index.cjs"
  },
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    },
    "./next": {
      "edge-light": { "types": "./dist/next/edge.d.ts", "default": "./dist/next/edge.js" },
      "import": { "types": "./dist/next/index.d.ts", "default": "./dist/next/index.js" },
      "require": { "types": "./dist/next/index.d.cts", "default": "./dist/next/index.cjs" }
    },
    "./next/client": {
      "import": { "types": "./dist/next/client/index.d.ts", "default": "./dist/next/client/index.js" },
      "require": { "types": "./dist/next/client/index.d.cts", "default": "./dist/next/client/index.cjs" }
    },
    "./next/tunnel": {
      "import": { "types": "./dist/next/tunnel/index.d.ts", "default": "./dist/next/tunnel/index.js" },
      "require": { "types": "./dist/next/tunnel/index.d.cts", "default": "./dist/next/tunnel/index.cjs" }
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE.md"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-trace-base": "^1.30.1",
    "source-map-js": "^1.2.1"
  },
  "peerDependencies": {
    "next": ">=15.0.0",
    "nodemailer": ">=6.0.0",
    "pg": ">=8.0.0",
    "react": ">=18.2.0"
  },
  "peerDependenciesMeta": {
    "next": { "optional": true },
    "nodemailer": { "optional": true },
    "pg": { "optional": true },
    "react": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "playwright": "1.63.0",
    "nodemailer": "^7.0.0",
    "react": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "~5.9.0",
    "vitest": "^3.2.0"
  }
}
